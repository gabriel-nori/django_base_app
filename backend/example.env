APP_NAME=django_base_app
APP_DESCRIPTION=django_base_app
ENV_NAME=DEV
SECRET_KEY="testahvbsbhabsuihasihj"
ALLOWED_HOSTS=127.0.0.1,0.0.0.0
# Extra origins allowed outside DEV (comma-separated)
CORS_ALLOWED_ORIGINS=

# Database: sqlite (default when empty), postgresql or mysql
DB_ENGINE=sqlite
# For sqlite DB_NAME is the file path (default: backend/db.sqlite3)
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
# Default: 5432 (postgresql), 3306 (mysql)
DB_PORT=

USE_REDIS_CACHE=false
REDIS_HOST=127.0.0.1
REDIS_DB_INDEX=1
REDIS_USE_SSL=false
REDIS_PORT=6379
REDIS_VALIDATE_CERT=false
REDIS_SSL_CA_CERTS=none
REDIS_PASSWORD=your_pass
# Optional: defaults to Redis DB 0 when USE_REDIS_CACHE=true
CELERY_BROKER_URL=

# Logging
LOG_LEVEL=info
# Persist Logger entries in the AppLog table
LOG_TO_DB=false
# Log every /api/ request (method, path, status, user, ip, duration)
LOG_REQUESTS=false

# Serve the built SPA (index.html + assets) from the backend
SERVE_SPA=false
# Default: backend/spa
SPA_DIR=
